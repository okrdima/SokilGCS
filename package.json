{
  "name": "sokil-gcs",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@sokil/backend",
    "dev:frontend": "turbo dev --filter=@sokil/gcs-frontend",
    "build": "turbo build",
    "build:backend": "turbo build --filter=@sokil/backend",
    "build:frontend": "turbo build --filter=@sokil/gcs-frontend",
    "build:contracts": "turbo run lint check-types build --filter=@sokil/contracts",
    "nest": "pnpm --filter @sokil/backend exec nest",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose --env-file .env.dev up -d",
    "db:down": "docker compose --profile app --env-file .env.dev down",
    "stack:up": "docker compose --profile app --env-file .env.dev up -d",
    "stack:down": "docker compose --profile app --env-file .env.dev down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
