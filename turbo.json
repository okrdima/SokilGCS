{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "lint": { "dependsOn": ["^build"], "outputs": [] },
    "build": {
      "dependsOn": ["^build", "lint"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["lint"],
      "cache": false,
      "persistent": true
    },
    "check-types": { "dependsOn": ["^build"] }
  }
}
