# NOT ignored: src/routeTree.gen.ts is committed.
# It is generated by TanStackRouterVite during dev/build, but `yarn build` runs
# `tsc -b` FIRST, and every route file imports types from it. On a clean
# checkout it does not exist yet, so the typecheck fails with 20 errors before
# Vite ever runs — which is exactly what happened on the first CI build. The
# plugin still regenerates it during the build, so a stale committed copy only
# affects the typecheck, never the shipped bundle.

# Self-host typography (B-01 2026-05-18) — source TTFs are too large + license-clean as upstream
# WOFF2 derivatives in public/fonts/ ARE committed.
scripts/fonts-src/*.ttf
scripts/fonts-src/*.otf

