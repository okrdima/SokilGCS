{
  "name": "@sokil/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-exports": "ts-node scripts/check-exports.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "devDependencies": {
    "@sokil/config": "workspace:*",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.1",
    "turbo": "^2.11.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "pnpm@12.4.2"
}
