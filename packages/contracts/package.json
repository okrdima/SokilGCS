{
  "name": "@sokil/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsc-watch --noClear --onSuccess \"tsc-alias\"",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "devDependencies": {
    "@sokil/config": "workspace:*",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.9.7",
    "tsc-watch": "^7.2.1",
    "turbo": "^2.11.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.4.2"
}
